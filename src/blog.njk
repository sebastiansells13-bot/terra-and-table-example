---
layout: layouts/page.njk
title: Journal
permalink: /blog/
---
<div class="max-w-3xl mx-auto px-6 py-12">
  <h1 class="font-display text-4xl font-bold text-moss-700 mb-8">Farm Journal</h1>
  <ul class="list-none p-0 space-y-6">
    {% for post in collections.posts | reverse %}
    <li class="border-b border-moss-100 pb-6">
      <a href="{{ post.url }}" class="font-display text-xl font-bold text-moss-700 no-underline hover:text-clay-500">{{ post.data.title }}</a>
      <p class="text-sm text-moss-700/60 mt-1">
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      </p>
      <p class="text-moss-700/80">{{ post.data.description }}</p>
    </li>
    {% endfor %}
  </ul>
</div>
