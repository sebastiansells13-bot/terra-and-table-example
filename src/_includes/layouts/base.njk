<!doctype html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ business.name or metadata.title }}</title>
  <meta name="description" content="{{ description or business.tagline or metadata.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <!-- Tailwind via CDN — no build step for CSS on this site (see README.md
       for why this differs from the other examples' Sass build). -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            moss: { 50: "#f4f7ed", 100: "#e6edd6", 300: "#b7cc85", 500: "#7a9a3f", 600: "#5f7a2f", 700: "#3f6212", 900: "#28400c" },
            clay: { 100: "#fbead9", 300: "#f0c290", 500: "#df9a4e" },
            cream: "#fdfbf3"
          },
          fontFamily: {
            display: ["Fraunces", "serif"],
            body: ["Nunito Sans", "sans-serif"]
          }
        }
      }
    };
  </script>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body class="bg-cream text-moss-900 font-body">
  {% include "components/header.njk" %}
  <main>
    {{ content | safe }}
  </main>
  {% include "components/footer.njk" %}
  <script src="/js/box-builder.js"></script>
</body>
</html>
