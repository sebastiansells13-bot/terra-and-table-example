---
layout: layouts/base.njk
---
<article class="max-w-3xl mx-auto px-6 py-12 prose">
  <h1 class="font-display text-4xl font-bold text-moss-700 mb-2">{{ title }}</h1>
  <time datetime="{{ date | htmlDateString }}" class="text-sm text-moss-700/60">{{ date | readableDate }}</time>
  <div class="mt-6 text-moss-700/90 leading-relaxed">
    {{ content | safe }}
  </div>
</article>
