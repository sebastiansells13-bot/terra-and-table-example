{% macro vegIcon(name) %}
  {% if name == "carrot" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><path d="M24 8 L30 20 L18 20 Z"/><path d="M24 20 L30 44 Q24 40 18 44 Z"/><path d="M22 6 L24 10 M26 6 L26 10 M20 8 L22 11"/></svg>
  {% elif name == "tomato" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><circle cx="24" cy="26" r="16"/><path d="M24 10 L20 6 M24 10 L28 6 M24 10 L24 4"/></svg>
  {% elif name == "leaf" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><path d="M10 40 Q10 12 38 8 Q34 36 10 40 Z"/><path d="M14 36 Q24 24 34 12"/></svg>
  {% elif name == "squash" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><rect x="10" y="16" width="28" height="18" rx="9"/><path d="M12 10 Q10 6 14 6"/></svg>
  {% elif name == "berry" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><circle cx="24" cy="28" r="14"/><path d="M18 14 L24 8 L30 14 M24 8 V16"/><circle cx="19" cy="24" r="1.2" fill="#3f6212"/><circle cx="26" cy="22" r="1.2" fill="#3f6212"/><circle cx="22" cy="32" r="1.2" fill="#3f6212"/><circle cx="29" cy="30" r="1.2" fill="#3f6212"/></svg>
  {% elif name == "corn" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><rect x="16" y="8" width="16" height="32" rx="8"/><path d="M16 14 H32 M16 20 H32 M16 26 H32 M16 32 H32"/></svg>
  {% elif name == "tuber" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><path d="M12 24 Q10 14 20 12 Q34 8 38 20 Q40 30 30 34 Q16 38 12 24 Z"/></svg>
  {% elif name == "bean" %}
  <svg viewBox="0 0 48 48" class="veg-icon w-10 h-10"><path d="M12 36 Q8 20 20 12 Q34 4 40 16 Q30 14 24 22 Q18 30 12 36 Z"/></svg>
  {% endif %}
{% endmacro %}
