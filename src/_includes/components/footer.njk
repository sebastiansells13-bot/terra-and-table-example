<footer class="bg-moss-700 text-moss-50 mt-16">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-wrap justify-between gap-4 text-sm">
    <span>&copy; {% year %} {{ business.name or metadata.title }}</span>
    <span>
      {% if business.email %}<a class="text-moss-50 underline" href="mailto:{{ business.email }}">{{ business.email }}</a>{% endif %}
      {% if business.phone %} · {{ business.phone }}{% endif %}
    </span>
  </div>
</footer>
