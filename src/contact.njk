---
layout: layouts/page.njk
title: Contact
permalink: /contact/
---
<div class="max-w-3xl mx-auto px-6 py-16">
  <h1 class="font-display text-4xl font-bold text-moss-700 mb-6">Contact</h1>
  <dl class="grid sm:grid-cols-3 gap-8">
    {% if business.phone %}
    <div><dt class="font-bold text-moss-700">Phone</dt><dd class="text-moss-700/80 m-0"><a href="tel:{{ business.phone }}">{{ business.phone }}</a></dd></div>
    {% endif %}
    {% if business.email %}
    <div><dt class="font-bold text-moss-700">Email</dt><dd class="text-moss-700/80 m-0"><a href="mailto:{{ business.email }}">{{ business.email }}</a></dd></div>
    {% endif %}
    {% if business.address %}
    <div><dt class="font-bold text-moss-700">Farm</dt><dd class="text-moss-700/80 m-0">{{ business.address }}</dd></div>
    {% endif %}
  </dl>
</div>
